# Get this from @BotFather on Telegram
BOT_TOKEN=

# From https://console.anthropic.com/settings/keys — this one is NOT free like
# the other bots' data sources. Every message sent to this bot costs a small
# amount (see README for rough numbers before you deploy).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Default is a balanced, capable model.
# Swap to a cheaper/faster model for high-volume use, or a stronger one for
# harder tasks — see README for current model names.
CLAUDE_MODEL=claude-sonnet-5
